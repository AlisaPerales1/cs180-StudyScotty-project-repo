  detailBody: { padding: 16 },
  title: { fontSize: 24, fontWeight: "700" },
  desc: { fontSize: 16, color: "#444", marginTop: 8 },
  sectionTitle: { fontSize: 17, fontWeight: "700", marginTop: 20 },
