DJANGO_DEBUG=true
# For deployment, set a unique random secret and DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=local-development-only-change-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Add your computer's LAN IP to ALLOWED_HOSTS for physical-phone testing.
# Leave blank to use SQLite. Set a PostgreSQL URL for deployment.
DATABASE_URL=
# Browser origins only; native apps do not require CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
